{
  "manifest_version": 3,
  "name": "Cookie Remover",
  "version": "1.1.0",
  "description": "Automatically remove website cookies at an interval you choose.",
  "minimum_chrome_version": "111",
  "permissions": ["alarms", "browsingData", "storage"],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Cookie Remover",
    "default_popup": "popup.html"
  }
}
